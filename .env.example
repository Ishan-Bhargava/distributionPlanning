# Copy this to ".env" (same folder as app.py) and fill in real values.
# ".env" is git-ignored - it never gets committed. Never put real secrets in
# this .example file.

OPTIFLOW_API_URL=https://your-api-id.execute-api.your-region.amazonaws.com/your-stage
OPTIFLOW_API_KEY=
